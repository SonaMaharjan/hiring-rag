# Local development configuration
# For deployment, these are set via Terraform / the deploy command.

# Vertex AI Configuration (default)
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# Alternatively, for Gemini API via Google AI Studio,
# comment out the three lines above and uncomment:
# GEMINI_API_KEY=your-api-key-here

# --- Hybrid System Configuration (Llama 3.2 + Gemini 2.5 Flash) ---
# Set USE_LOCAL_LLM=true to offload heavy batch pipelines (CV ingestion, prompt injection checks, scoring, Self-RAG) to local Ollama (Llama 3.2), reducing cloud API resource consumption.
USE_LOCAL_LLM=false
LOCAL_LLM_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3.2
GEMINI_MODEL=gemini-2.5-flash

# --- LangSmith Observability & Tracing ---
# Enable LangSmith tracing across all pipeline steps (@traceable decorated functions)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your-langsmith-api-key
LANGCHAIN_PROJECT=hiring-rag

